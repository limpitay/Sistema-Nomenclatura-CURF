NODE_ENV=production

# --- BASE DE DATOS ---
# Usadas por docker-compose para levantar el contenedor de Postgres
DB_USER=user
DB_PASSWORD=poner_aqui_tu_password_segura
DB_NAME=db_name
# Leída directamente por backend/src/db.js (debe apuntar al mismo user/password/name de arriba)
DATABASE_URL=postgresql://user:poner_aqui_tu_password_segura@postgres:5432/db_name

# --- API ---
PORT=3001
REACT_APP_API_URL=http://localhost:3001
# Orígenes permitidos (separados por coma). Sin esto, la API acepta cualquier origen.
# En producción: https://<IP-del-servidor>[:PUERTO_HTTPS] (ej: https://192.168.14.167:8443)
CORS_ORIGIN=http://localhost:8080

# --- HTTPS (solo docker-compose.prod.yml) ---
# Certificado: bash scripts/certificado.sh (queda en certs/, no se sube a git).
# Puertos publicados en el servidor. Si el 443 ya lo usa otra app (ej. ad-reorg),
# usar otro: PUERTO_HTTPS=8443 y CORS_ORIGIN=https://<IP-del-servidor>:8443
# El de HTTP solo redirige a HTTPS.
PUERTO_HTTPS=443
PUERTO_HTTP=80

# --- CACHÉ / LOCKS (REDIS) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=poner_aqui_otra_password_segura

# --- SEGURIDAD Y AUTENTICACIÓN ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=un_hash_seguro_y_largo_para_jwt_tokens
JWT_EXPIRES=8h

# --- LOGIN ---
# local = contraseña propia del sistema (bcrypt en la tabla users)
# ldap  = contraseña de Windows del dominio (Active Directory). Igual solo entra
#         quien esté dado de alta en /admin con su usuario de dominio (ej. jperez).
AUTH_MODE=local
# Controlador de dominio. ldap://...:389 manda la contraseña sin cifrar por la red interna:
# si el DC tiene certificado, preferí ldaps://NOMBRE-DC.curf.net:636
# El contenedor de la API tiene que poder resolver el nombre (si no, poné la IP del DC).
LDAP_URL=ldap://IP-DEL-DC:389
LDAP_DOMINIO=curf.net
# true = acepta el certificado del DC aunque sea autofirmado/interno (solo con ldaps://)
LDAP_TLS_INSECURE=false

# --- EQUIPOS AD (sección de solo lectura) ---
# Cuenta para consultar el AD: alcanza un usuario común del dominio, sin privilegios
# (puede ser la misma que usa ad-reorg). Ej: svc-nomenclatura (o svc-nomenclatura@curf.net)
LDAP_LECTURA_USUARIO=
LDAP_LECTURA_PASSWORD=
# OU desde donde se listan los equipos (incluye subcarpetas)
LDAP_EQUIPOS_BASE=OU=Equipos,OU=CURF,DC=curf,DC=net
