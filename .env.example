NODE_ENV=production

# --- BASE DE DATOS ---
# Usadas por docker-compose para levantar el contenedor de Postgres
DB_USER=user
DB_PASSWORD=poner_aqui_tu_password_segura
DB_NAME=db_name
# Leída directamente por backend/src/db.js (debe apuntar al mismo user/password/name de arriba)
DATABASE_URL=postgresql://user:poner_aqui_tu_password_segura@postgres:5432/db_name

# --- API ---
PORT=3001
REACT_APP_API_URL=http://localhost:3001
# Orígenes permitidos (separados por coma). Sin esto, la API acepta cualquier origen.
CORS_ORIGIN=http://localhost:8080

# --- CACHÉ / LOCKS (REDIS) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=poner_aqui_otra_password_segura

# --- SEGURIDAD Y AUTENTICACIÓN ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=un_hash_seguro_y_largo_para_jwt_tokens
JWT_EXPIRES=8h
