# nginx de PRODUCCIÓN con HTTPS (mismo esquema que ad-reorg). Lo usa
# docker-compose.prod.yml en lugar de nginx.conf (que queda para desarrollo).
# Es una plantilla: al arrancar, la imagen de nginx reemplaza ${PUERTO_HTTPS}
# y la deja como /etc/nginx/nginx.conf.
# Certificado: certs/nomenclatura.crt + .key (los genera scripts/certificado.sh).

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml+rss image/svg+xml;

    # Si alguien entra por http:// (puerto 80), mandarlo a https://
    server {
        listen 80 default_server;
        server_name _;
        return 301 https://$host:${PUERTO_HTTPS}$request_uri;
    }

    # HTTPS: la contraseña del login no viaja legible por la red
    server {
        listen 443 ssl default_server;
        http2 on;
        server_name _;

        ssl_certificate     /etc/nginx/certs/nomenclatura.crt;
        ssl_certificate_key /etc/nginx/certs/nomenclatura.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 1h;

        # Si alguien entra con http:// al puerto HTTPS, redirigirlo
        # ($http_host trae el puerto publicado; $server_port sería el 443 interno del contenedor)
        error_page 497 =301 https://$http_host$request_uri;

        root /usr/share/nginx/html;
        index index.html index.htm;

        # Archivos estáticos con tipos MIME correctos
        location ~* \.js$ {
            add_header Content-Type application/javascript;
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        location ~* \.css$ {
            add_header Content-Type text/css;
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        location ~* \.(svg|woff|woff2|ttf|eot)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        # Headers de seguridad básicos
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

        # React SPA - servir index.html para todas las rutas
        location / {
            try_files $uri $uri/ /index.html;
            add_header Cache-Control "no-cache";
        }

        # Proxy al API
        location /api/ {
            proxy_pass http://api:3001;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            # nginx es la puerta de entrada: se pisa (no se agrega) lo que mande
            # el navegador, así nadie falsifica su IP en el límite de logins
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
